// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Tenant {
  id                 String   @id @default(uuid())
  name               String
  shopDomain         String?  @unique
  shopifyAccessToken String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users      User[]
  customers  Customer[]
  products   Product[]
  orders     Order[]
  orderItems OrderItem[]
  events     Event[]

  @@map("tenants")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String   @default("admin")
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Customer {
  id                String   @id @default(uuid())
  tenantId          String
  shopifyCustomerId BigInt
  firstName         String?
  lastName          String?
  email             String?
  phone             String?
  createdAt         DateTime
  updatedAt         DateTime

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]
  events Event[]

  @@unique([tenantId, shopifyCustomerId])
  @@map("customers")
}

model Product {
  id               String   @id @default(uuid())
  tenantId         String
  shopifyProductId BigInt
  title            String
  status           String?
  createdAt        DateTime
  updatedAt        DateTime

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([tenantId, shopifyProductId])
  @@map("products")
}

model Order {
  id              String    @id @default(uuid())
  tenantId        String
  shopifyOrderId  BigInt
  orderNumber     String?
  customerId      String?
  totalPrice      Float
  currency        String    @default("USD")
  financialStatus String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@unique([tenantId, shopifyOrderId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  tenantId  String
  orderId   String
  productId String?
  quantity  Int
  price     Float

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model Event {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String?
  eventType  String
  metadata   String? // Changed from Json to String for SQLite compatibility
  occurredAt DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@map("events")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}
